    {
      "parameters": {
        "jsCode": "const now = DateTime.now().setZone('Asia/Karachi');\n\nreturn items.filter(item => {\n  const due = DateTime.fromFormat(\n    item.json['Due Date'],\n    \"dd LLL yyyy, h:mm a\",\n    { zone: 'Asia/Karachi' }\n  );\n  if (!due.isValid) return false;\n\n  const hoursUntilDue = due.diff(now, 'hours').hours;\n  const lastSent = item.json['Last Reminder Sent'];\n\n  // Overdue: send exactly one reminder, then stop forever\n  if (hoursUntilDue < 0) {\n    return !lastSent;\n  }\n\n  // Too far out, no reminder yet\n  if (hoursUntilDue > 48) return false;\n\n  const requiredIntervalHours = hoursUntilDue <= 24 ? 7 : 24;\n\n  if (!lastSent) return true;\n\n  const lastSentDate = DateTime.fromFormat(\n    lastSent,\n    \"dd LLL yyyy, h:mm a\",\n    { zone: 'Asia/Karachi' }\n  );\n\n  // Safety: if Last Reminder Sent is malformed, treat as never-sent rather than silently blocking forever\n  if (!lastSentDate.isValid) return true;\n\n  const hoursSinceLast = now.diff(lastSentDate, 'hours').hours;\n  return hoursSinceLast >= requiredIntervalHours;\n});"
      },
