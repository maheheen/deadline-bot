      "parameters": {
        "jsCode": "const triggerData = $('WhatsApp Trigger').first().json;\n\n// Skip status callbacks (delivered/read receipts) — only process real incoming messages\nif (!triggerData.messages || !triggerData.messages[0]) {\n  return []; // nothing to process, exit cleanly instead of crashing\n}\n\nconst rows = $input.all();\nconst lines = rows.map(r =>\n  `${r.json.row_number} | ${r.json['Course Name']} | ${r.json['Assigned Task']} | ${r.json['Due Date']}`\n);\nreturn [{ json: {\n  pendingTasksAsText: lines.length ? lines.join('\\n') : 'None',\n  incomingMessage: triggerData.messages[0].text.body\n}}];"
      },
