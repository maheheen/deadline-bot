    {
      "parameters": {
        "jsCode": "const data = $json.output[0].content[0].text;\n\nif (data.intent === 'new_task') {\n  return data.tasks.map(t => ({ json: { intent: 'new_task', ...t } }));\n}\n\nif (data.intent === 'submission_update') {\n  return data.matched_row_numbers.map(rowNum => ({\n    json: { intent: 'submission_update', matched_row_number: rowNum, matched_summary: data.matched_summary }\n  }));\n}\n\nreturn [{ json: data }];"
      },
